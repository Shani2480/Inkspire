{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inkspire",
  "version": "0.1.0",
  "identifier": "com.aiword.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Inkspire",
        "width": 1100,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "zoomHotkeysEnabled": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": ["ipc:", "http://ipc.localhost", "https://cdn.jsdelivr.net", "https://docs.google.com"],
        "img-src": ["'self'", "asset:", "http://asset.localhost", "https://asset.localhost", "blob:", "data:"],
        "font-src": ["'self'", "data:", "asset:", "http://asset.localhost", "https://asset.localhost"],
        "style-src": ["'self'", "'unsafe-inline'", "asset:", "http://asset.localhost", "https://asset.localhost"],
        "worker-src": ["'self'", "blob:"],
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      },
      "devCsp": {
        "default-src": "'self' http://localhost:1420 http://127.0.0.1:1420",
        "connect-src": [
          "ipc:",
          "http://ipc.localhost",
          "https://cdn.jsdelivr.net",
          "ws://localhost:1420",
          "ws://localhost:1421",
          "ws://127.0.0.1:1420",
          "ws://127.0.0.1:1421",
          "http://localhost:1420",
          "http://127.0.0.1:1420"
        ],
        "img-src": ["'self'", "asset:", "http://asset.localhost", "https://asset.localhost", "blob:", "data:"],
        "font-src": ["'self'", "data:", "asset:", "http://asset.localhost", "https://asset.localhost"],
        "style-src": ["'self'", "'unsafe-inline'", "asset:", "http://asset.localhost", "https://asset.localhost"],
        "script-src": ["'self'", "'unsafe-eval'", "http://localhost:1420", "http://127.0.0.1:1420"],
        "worker-src": ["'self'", "blob:"],
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
